<script>
window.QUIZ = {
  questions: [
    { q: 'Você já é aposentado ou está prestes a se aposentar?', opts: ['Sim, já sou aposentado', 'Ainda não, mas vou pedir em breve', 'Não'] },
    { q: 'Você trabalhou exposto a agente nocivo (ruído, calor, agentes químicos, insalubridade ou periculosidade)?', opts: ['Sim', 'Acho que sim, não tenho certeza', 'Não'] },
    { q: 'Você tem ou consegue o PPP ou o LTCAT desse período?', opts: ['Tenho o documento', 'Consigo pedir à empresa', 'Não tenho e não sei como conseguir'] },
    { q: 'O INSS considerou esse tempo como especial no cálculo?', opts: ['Não considerou', 'Não sei dizer', 'Sim, considerou'] },
    { q: 'Há quanto tempo você se aposentou?', opts: ['Menos de 10 anos', 'Mais de 10 anos', 'Ainda não me aposentei'] }
  ],
  result: function (a) {
    if (a[1] === 'Não') return { title: 'Essa revisão depende de exposição a agente nocivo', text: 'Existem outras revisões possíveis, como erro de cálculo, ação trabalhista e atividades concomitantes. Envie as respostas e conte a sua situação.', link: { href: '/revisao/aposentadoria', label: 'Ver as outras revisões' } };
    if (a[4] === 'Mais de 10 anos') return { title: 'Vale conferir o prazo', text: 'Com mais de 10 anos de aposentadoria, o prazo de revisão pode ter terminado. A contagem começa no mês seguinte ao primeiro pagamento. Envie as respostas e a carta de concessão para conferirmos.' };
    if (a[4] === 'Ainda não me aposentei') return { title: 'Antes de pedir, inclua o tempo especial', text: 'Como você ainda não se aposentou, o tempo especial pode entrar já no pedido. Envie as respostas e o PPP para calcularmos a regra mais vantajosa.', link: { href: '/analise-do-cnis/tempo-especial', label: 'Ver a página sobre tempo especial antes da aposentadoria' } };
    return { title: 'O seu caso merece uma análise', text: 'Pelas respostas, vale verificar se o tempo especial pode aumentar o seu benefício. Envie as respostas e a carta de concessão. A nossa equipe analisa e explica o próximo passo.' };
  },
  summary: function (a) {
    return 'Olá! Vim pelo site e fiz o teste da revisão por tempo especial. Minhas respostas: 1) Benefício do INSS: ' + a[0] + '; 2) Exposição a agente nocivo: ' + a[1] + '; 3) PPP/LTCAT: ' + a[2] + '; 4) INSS considerou como especial: ' + a[3] + '; 5) Tempo desde a aposentadoria: ' + a[4] + '. Gostaria de uma análise do meu caso.';
  }
};
</script>

