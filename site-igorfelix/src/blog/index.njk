permalink: /blog/index.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="pt-BR" class="no-js">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{%- set waMsg = "Olá! Vim pelo blog do site e gostaria de tirar uma dúvida sobre aposentadoria." %}
{%- set headerSolid = true %}
{%- set area = "" %}
<title>Blog sobre Aposentadoria e Revisão do INSS | Igor Felix Advogados</title>
<meta name="description" content="Artigos em linguagem clara sobre aposentadoria do INSS: CNIS, pedido negado, tempo especial e revisão de aposentadoria.">
<link rel="canonical" href="{{ site.url }}/blog/">
<meta name="robots" content="index, follow">
<meta name="theme-color" content="#0B1E36">
<link rel="icon" type="image/png" href="/assets/favicon.png">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<script>document.documentElement.className=document.documentElement.className.replace('no-js','js');</script>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Igor Felix Advogados Associados">
<meta property="og:title" content="Blog sobre Aposentadoria e Revisão do INSS | Igor Felix Advogados">
<meta property="og:description" content="Artigos em linguagem clara sobre aposentadoria e revisão de aposentadoria do INSS.">
<meta property="og:url" content="{{ site.url }}/blog/">
<meta property="og:image" content="{{ site.url }}/og-image.jpg">
<meta property="og:locale" content="pt_BR">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/site.css?v=20261125b">
<link rel="stylesheet" href="/assets/blog.css?v=20261125">
</head>
<body>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<div id="pbar"></div>

{% include "layouts/header.njk" %}

<main id="conteudo">
<section class="blog-hero">
  <div class="container">
    <span class="eyebrow">Blog do escritório</span>
    <h1>Artigos sobre aposentadoria e revisão do INSS</h1>
    <p>Aqui você entende o CNIS, o que fazer quando o INSS nega o pedido e como conferir o cálculo da aposentadoria. O conteúdo é informativo e não substitui a análise do seu caso.</p>
  </div>
</section>

<div class="filter-bar">
  <div class="container">
    <div class="filter-chips" id="filterChips">
      <button class="chip active" type="button" data-filter="all">Todos</button>
      <button class="chip" type="button" data-filter="aposentadoria">Aposentadoria</button>
      <button class="chip" type="button" data-filter="revisao">Revisão de aposentadoria</button>
    </div>
  </div>
</div>

<section class="blog-list">
  <div class="container">
    <div class="post-grid" id="cards">
      {% for post in collections.posts %}
      {%- set cat = post.data.category %}
      {%- set postArea = "aposentadoria" if cat == "aposentadorias" else ("outros" if (cat == "outros" or cat == "incapacidade") else "revisao") %}
      <a class="post-card" data-area="{{ postArea }}" data-cat="{{ cat }}" href="{{ post.url }}">
        <div class="card-thumb">
          <span class="cat">{{ categories[cat] or "Artigo" }}</span>
          <span class="mono"><svg viewBox="0 0 48 48"><rect x="8" y="6" width="32" height="36" rx="3" fill="none"/><path d="M15 16h18M15 23h18M15 30h12" fill="none"/></svg></span>
        </div>
        <div class="card-body">
          <div class="meta"><span>{{ categories[cat] or "Artigo" }}</span><span>•</span><span>{{ post.templateContent | readingTime }} min de leitura</span></div>
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.description }}</p>
          <span class="read">Ler artigo
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>
      {% endfor %}
    </div>
    <p class="empty-note" id="emptyNote" hidden>Ainda não há artigos publicados neste assunto. Enquanto isso, veja as páginas de <a href="/#analise" style="text-decoration:underline">análise do CNIS</a> e de <a href="/revisao/aposentadoria" style="text-decoration:underline">revisão</a>.</p>
  </div>
</section>

<section class="cta-band">
  <div class="container">
    <h2>Tem uma dúvida sobre a sua aposentadoria?</h2>
    <p>Fale com a nossa equipe pelo WhatsApp. O primeiro atendimento serve para entender o seu caso e orientar os próximos passos.</p>
    <a class="btn btn-gold" href="{{ waMsg | waLink }}" target="_blank" rel="noopener">{% waIcon %}Falar no WhatsApp</a>
  </div>
</section>
</main>

{% include "layouts/footer.njk" %}
<script src="/assets/site.js?v=20261125b" defer></script>
<script>
(function(){
  var chips=document.querySelectorAll('#filterChips .chip'),cards=document.querySelectorAll('#cards .post-card'),note=document.getElementById('emptyNote');
  chips.forEach(function(c){c.addEventListener('click',function(){
    chips.forEach(function(x){x.classList.remove('active');});c.classList.add('active');
    var f=c.getAttribute('data-filter'),visible=0;
    cards.forEach(function(card){var show=f==='all'||card.getAttribute('data-area')===f;card.style.display=show?'':'none';if(show)visible++;});
    note.hidden=visible>0;
  });});
})();
</script>
</body>
</html>
