    <a href="/" class="brand" aria-label="Igor Felix Advogados Associados">
      <img src="/assets/logo.png" alt="Igor Felix Advogados Associados">
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Abrir menu"><span></span><span></span><span></span></button>
    <nav class="nav-menu" id="navMenu">
