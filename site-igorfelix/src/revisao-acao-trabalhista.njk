    { q: 'A ação reconheceu vínculo de emprego, salários maiores ou adicionais (insalubridade, periculosidade, horas extras)?', opts: ['Sim', 'Acho que sim, não tenho certeza', 'Não'] },
    { q: 'Depois da ação trabalhista, o INSS recalculou o valor do benefício?', opts: ['Não, ficou tudo igual', 'Não sei dizer', 'Sim, já recalculou'] }
  ],
  result: function (a) {
    if (a[1] === 'Não tive ação trabalhista') return { title: 'Essa revisão depende de uma ação trabalhista', text: 'Existem outras revisões possíveis, como tempo especial, atividades concomitantes e erro de cálculo. Envie as respostas e conte a sua situação.', link: { href: '/revisao/aposentadoria', label: 'Ver as outras revisões' } };
    if (a[0] === 'Ainda não, mas vou pedir em breve') return { title: 'Inclua a ação já no pedido', text: 'Como você ainda não se aposentou, o vínculo e os salários reconhecidos podem entrar já no pedido de aposentadoria. Envie as respostas e o número do processo trabalhista.', link: { href: '/analise-do-cnis/vinculo-com-pendencia', label: 'Ver a página sobre vínculo com pendência no CNIS' } };
    return { title: 'O seu caso merece uma análise', text: 'Pelas respostas, vale verificar se a ação trabalhista pode aumentar o seu benefício. Envie as respostas e, se tiver, a sentença ou o número do processo. A nossa equipe responde com orientação clara.' };
