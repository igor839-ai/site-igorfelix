    return 'Olá! Vim pelo site e fiz o teste da revisão por ação trabalhista. Minhas respostas: 1) Aposentadoria do INSS: ' + a[0] + '; 2) Ação trabalhista: ' + a[1] + '; 3) Reconheceu vínculo, salários ou adicionais: ' + a[2] + '; 4) INSS recalculou: ' + a[3] + '. Gostaria de uma análise do meu caso.';
  }
};
</script>

