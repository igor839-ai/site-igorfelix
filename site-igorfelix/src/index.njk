  caption: "Exemplo ilustrativo dos problemas de CNIS mais comuns."
}) }}
{% endcall %}

<section class="section bg-band" id="sinais">
  <div class="container">
    {{ m.head("Sinais de erro", "Os sinais de que o seu CNIS pode travar ou diminuir a aposentadoria.", "Se alguma das situações abaixo aconteceu na sua vida profissional, vale conferir o CNIS antes de pedir a aposentadoria.") }}
    {{ m.sinais(sinais, true) }}
    <div class="sinais-foot reveal">
      <a class="btn btn-gold" href="#checagem">{% icon "search" %}Fazer a checagem do meu CNIS</a>
    </div>
  </div>
</section>

<section class="section bg-white" id="analise">
  <div class="container split">
    <div class="reveal">
      <span class="eyebrow">Análise do CNIS</span>
      <h2 style="font-size:clamp(1.75rem,3.6vw,2.5rem);margin:.85rem 0 1rem">Por que corrigir o CNIS antes de pedir a aposentadoria?</h2>
      <div class="prose-block">
        <p>O simulador do INSS só conta o que está certo no CNIS. Vínculos com pendência, contribuições abaixo do mínimo, tempo especial e deficiência não entram sozinhos na conta, e o pedido feito com esse CNIS pode sair negado ou com um valor menor.</p>
        <p>Depois do pedido, a correção costuma ser mais lenta, porque passa por recurso, novo pedido ou ação judicial. Antes dele, dá para acertar o cadastro e pedir pela regra certa, no momento certo.</p>
      </div>
      <p style="margin-top:1.2rem"><a class="link-arrow" href="/aposentadoria-dos-pais">Está pesquisando pelo seu pai ou pela sua mãe? Veja como ajudar {% icon "arrow" %}</a></p>
    </div>
    <div class="panel reveal d1">
      <h3>O que não entra sozinho no CNIS</h3>
      <ul>
        <li>{% icon "x" %}Vínculos sem data de saída ou com indicador de pendência</li>
        <li>{% icon "x" %}Contribuições abaixo do salário mínimo</li>
        <li>{% icon "x" %}Meses como MEI ou no plano simplificado, nas regras por tempo de contribuição</li>
        <li>{% icon "x" %}Tempo especial de quem trabalhou exposto a agentes nocivos</li>
        <li>{% icon "x" %}Deficiência, que reduz o tempo exigido</li>
        <li>{% icon "x" %}Tempo de serviço público, que depende da certidão (CTC)</li>
      </ul>
    </div>
  </div>
</section>

<section class="section bg-band" id="como-funciona">
  <div class="container">
    {{ m.head("Como funciona", "Da checagem do CNIS ao pedido da aposentadoria.", "Primeiro descobrimos o que está errado. Depois corrigimos o CNIS e só então fazemos o pedido.") }}
    {{ m.jornada() }}
  </div>
</section>

{{ m.checagem({
  h2: "Seu CNIS tem sinais de erro? Faça a checagem.",
  p: "São seis perguntas, uma por tela. No fim, você vê o resultado e pode enviar as respostas pelo WhatsApp com a mensagem pronta.",
  first: "Quem está preenchendo?",
  wa: wa
}) }}
<script>
window.CHECK = (function () {
  var S = {{ sinais | dump | safe }};
  var SQ = S.filter(function (s) { return s.id !== 'negado'; });
  var quem = ['Eu mesmo', 'Para meu pai ou minha mãe', 'Para meu cônjuge ou companheiro(a)'];
  var idades = ['Até 49 anos', '50 a 54 anos', '55 a 59 anos', '60 a 64 anos', '65 anos ou mais'];
  var situacoes = ['Ainda não pedi', 'Pedi e está em análise', 'Recebi uma exigência do INSS', 'Foi negado'];
  var tempos = ['Menos de 15 anos', '15 a 24 anos', '25 a 29 anos', '30 a 34 anos', '35 anos ou mais', 'Não sei'];
  var acesso = ['Sim', 'Não', 'Não sei'];
  function opts(arr) { return arr.map(function (t) { return { t: t }; }); }
  function lc(s) { return s.charAt(0).toLowerCase() + s.slice(1); }
  function marcados(a) { return (a[4] || []).filter(function (i) { return i < SQ.length; }).map(function (i) { return SQ[i]; }); }
  function longe(a) { return a[1] === 0 || (a[1] === 1 && a[3] <= 1); }
  function extra(a) {
    var t = '';
    if (a[0] > 0) t += ' Como você está ajudando um familiar, a nossa equipe conversa com você e orienta o que ele precisa autorizar e assinar.';
    if (a[5] > 0) t += ' Sem acesso ao Meu INSS, orientamos o acesso passo a passo.';
    return t;
  }
  return {
    questions: [
      { q: 'Quem está preenchendo?', opts: opts(quem) },
      { q: 'Qual é a idade de quem vai se aposentar?', opts: opts(idades) },
      { q: 'Já pediu a aposentadoria no INSS?', opts: opts(situacoes) },
      { q: 'Quanto tempo de contribuição, mais ou menos?', opts: opts(tempos) },
      { q: 'Marque o que aconteceu na vida profissional.', hint: 'Pode marcar mais de uma opção.', multi: true, none: true, opts: SQ.map(function (s) { return { t: s.t, d: s.d }; }).concat([{ t: 'Nenhum destes' }]) },
      { q: 'Tem acesso ao Meu INSS?', opts: opts(acesso) }
    ],
    result: function (a) {
      var m = marcados(a);
      if (a[2] === 3) return { title: 'O pedido foi negado, e o recurso tem prazo.', text: 'O recurso contra a negativa deve ser apresentado em até 30 dias, contados de quando você soube da decisão. Envie as respostas e, se tiver, a carta de indeferimento e o CNIS.' + extra(a), link: { href: '/aposentadoria-negada', label: 'Ver o que fazer depois da negativa' }, btn: 'Enviar pelo WhatsApp agora' };
      if (a[2] === 2) return { title: 'A exigência tem prazo para ser cumprida.', text: 'A carta de exigência informa o prazo para entregar os documentos, e o pedido pode ser negado se ele passar. Envie as respostas e, se tiver, a carta e o CNIS.' + extra(a), link: { href: '/aposentadoria-negada', label: 'Ver o que fazer com a carta de exigência' }, btn: 'Enviar pelo WhatsApp agora' };
      if (m.length) {
        var dest = m.filter(function (s) { return s.url.indexOf('#') === -1; })[0];
        return { title: 'Seu CNIS tem sinais de erro.', text: 'Os sinais que você marcou podem atrasar ou diminuir a sua aposentadoria. Envie o seu CNIS para o diagnóstico.' + (a[2] === 1 ? ' Como o pedido está em análise, ainda dá para juntar documentos.' : '') + extra(a), link: dest ? { href: dest.url, label: dest.page } : null };
      }
      if (a[2] === 1) return { title: 'Nenhum sinal de erro nas respostas.', text: 'Enquanto o INSS analisa o pedido, vale conferir se o CNIS está completo. Uma pendência que passou despercebida pode mudar a data ou o valor, e ainda dá para juntar documentos.' + extra(a) };
      if (longe(a)) return { title: 'Hoje não vemos sinais de erro.', text: 'Guarde o seu CNIS e refaça a checagem perto da data da aposentadoria. Se quiser, mandamos um lembrete pelo WhatsApp.', btn: 'Receber um lembrete pelo WhatsApp', quiet: true, wa: 'Olá! Fiz a checagem do CNIS no site e não apareceram sinais de erro. Quero um lembrete para refazer a checagem perto da data. Idade: ' + lc(idades[a[1]]) + '.' };
      return { title: 'Nenhum sinal de erro nas respostas.', text: 'Com a aposentadoria próxima, vale conferir o CNIS antes do pedido. O simulador só conta o que está certo no cadastro, e uma pendência que passou despercebida pode mudar a data ou o valor.' + extra(a) };
    },
    summary: function (a) {
      var m = marcados(a).map(function (s) { return s.short; });
      return 'Olá! Fiz a checagem do CNIS no site. Quem preenche: ' + lc(quem[a[0]]) + '. Idade: ' + lc(idades[a[1]]) + '. Situação: ' + lc(situacoes[a[2]]) + '. Tempo de contribuição: ' + lc(tempos[a[3]]) + '. Sinais: ' + (m.length ? m.join(', ') : 'nenhum') + '. Acesso ao Meu INSS: ' + lc(acesso[a[5]]) + '.';
    },
    track: function (a) {
      return { faixa_idade: idades[a[1]], situacao: situacoes[a[2]], qtd_sinais: marcados(a).length + (a[2] >= 2 ? 1 : 0) };
    }
  };
})();
</script>

