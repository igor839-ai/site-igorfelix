  lead: "Além da idade, são exigidos 15 anos de contribuição para quem contribuía antes da reforma. Muita gente acha que não tem esse tempo porque vínculos antigos não aparecem no CNIS. Conferimos o extrato e os documentos e mostramos o que falta, se faltar.",
  cta: "Quero saber se já posso",
  cta2: { label: "Está ajudando o seu pai ou a sua mãe?", href: "#familia" }
} %}
{% call m.hero(heroData, wa, crumbs) %}
{{ m.ddoc({
