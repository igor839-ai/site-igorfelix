      { icon: "briefcase", t: "Carteiras de trabalho", d: "Fotos de todas as páginas, inclusive das carteiras antigas." },
      { icon: "wallet", t: "Carnês ou guias", d: "Se contribuiu como autônomo, facultativo ou MEI.", opt: "Se houver" },
      { icon: "hat", t: "PPP", d: "Se trabalhou exposto a ruído, calor, produtos químicos, agentes biológicos ou eletricidade.", opt: "Se houver" },
      { icon: "building", t: "CTC", d: "A certidão de tempo de contribuição de prefeitura, estado ou outro órgão público.", opt: "Se houver" },
      { icon: "docX", t: "Carta do INSS", d: "A carta de indeferimento ou de exigência, se você já fez o pedido.", opt: "Se houver" }
    ]) }}
    <div class="notice reveal" style="margin-top:1.8rem">
      <div class="n-ic">{% icon "phone" %}</div>
      <div>
        <h3>Não tem acesso ao Meu INSS?</h3>
