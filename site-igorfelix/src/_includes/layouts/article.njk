<!DOCTYPE html>
<html lang="pt-BR" class="no-js">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{%- set catLabel = categories[category] or "Artigo" %}
{%- set isAposentadoria = (category == "aposentadorias") %}
{%- set waMsg = "Olá! Li um artigo no blog do site e quero conferir o meu CNIS antes de me aposentar." if isAposentadoria else "Olá! Li um artigo no blog do site e quero saber se a minha aposentadoria pode ser revisada." %}
{%- set headerSolid = true %}
{%- set area = "" %}
<title>{{ seoTitle or (title + " | Igor Felix Advogados") }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta name="robots" content="index, follow, max-image-preview:large">
<meta name="theme-color" content="#0B1E36">
<link rel="icon" type="image/png" href="/assets/favicon.png">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<script>document.documentElement.className=document.documentElement.className.replace('no-js','js');</script>
<meta property="og:type" content="article">
<meta property="og:site_name" content="Igor Felix Advogados Associados">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/{{ ogimage or 'og-image.jpg' }}">
<meta property="og:locale" content="pt_BR">
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href="/assets/sora-latin-wght.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/manrope-latin-wght.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/site.css?v=20261126a">
<link rel="stylesheet" href="/assets/blog.css?v=20261125">
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Article",
  "headline":{{ title | dump | safe }},
  "description":{{ description | dump | safe }},
  "image":"{{ site.url }}/{{ ogimage or 'og-image.jpg' }}",
  "datePublished":"{{ date | isoDate }}",
  "dateModified":"{{ date | isoDate }}",
  "author":{"@type":"Person","name":"Igor Felix","jobTitle":"Advogado","identifier":"OAB/SP 321.638"},
  "publisher":{"@type":"LegalService","name":"Igor Felix Advogados Associados","url":"{{ site.url }}/"},
  "mainEntityOfPage":{"@type":"WebPage","@id":"{{ site.url }}{{ page.url }}"},
  "inLanguage":"pt-BR",
  "articleSection":{{ catLabel | dump | safe }}
}
</script>
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name":"Início","item":"{{ site.url }}/"},
    {"@type":"ListItem","position":2,"name":"Blog","item":"{{ site.url }}/blog/"},
    {"@type":"ListItem","position":3,"name":{{ title | dump | safe }},"item":"{{ site.url }}{{ page.url }}"}
  ]
}
</script>
</head>
<body>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<div id="pbar"></div>

{% include "layouts/header.njk" %}

<main id="conteudo">
<article class="article-wrap">
  <div class="container">
    <nav class="breadcrumb" aria-label="Trilha">
      <a href="/">Início</a> ›
      <a href="/blog/">Blog</a> ›
      <span>{{ catLabel }}</span>
    </nav>

    <div class="article-head">
      <span class="cat">{{ catLabel }}</span>
      <h1>{{ title }}</h1>
      {% if sub %}<p class="sub">{{ sub }}</p>{% endif %}
      <div class="article-meta">
        <span>Por Dr. Igor Felix, OAB/SP 321.638</span>
        <span class="dot"></span>
        <span>{{ date | dateBR }}</span>
        <span class="dot"></span>
        <span>{{ content | readingTime }} min de leitura</span>
      </div>
    </div>

    <div class="prose">
      {{ content | safe }}
    </div>

    <div class="author">
      <div class="av">IF</div>
      <div>
        <h4>Dr. Igor Felix</h4>
        <p>Advogado previdenciário, OAB/SP 321.638. Atua na análise do CNIS, no pedido e na revisão de aposentadorias do INSS, em Pinheiros (SP) e on-line.</p>
      </div>
    </div>
  </div>
</article>

{% set related = collections.posts | selectattr("data.category","equalto",category) | rejectattr("url","equalto",page.url) %}
{% if related.length %}
<section class="related">
  <div class="container">
    <span class="eyebrow">Continue lendo</span>
    <h2>Artigos sobre esse assunto</h2>
    <p class="lead">Outros conteúdos sobre {{ catLabel | lower }}.</p>
    <div class="post-grid">
      {% for post in related | reverse | slice(0,3) %}
      <a class="post-card" href="{{ post.url }}">
        <div class="card-thumb"><span class="cat">{{ categories[post.data.category] or "Artigo" }}</span></div>
        <div class="card-body">
          <h3 style="margin-top:.2rem">{{ post.data.title }}</h3>
          <p>{{ post.data.description }}</p>
          <span class="read">Ler artigo</span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if videos %}
<section class="related"{% if related.length %} style="padding-top:0"{% endif %}>
  <div class="container">
    <h2>Vídeos sobre esse assunto</h2>
    <div class="rel-videos">
      {% for v in videos %}
      <div class="video-card">
        <iframe class="video-embed" loading="lazy" src="https://www.youtube-nocookie.com/embed/{{ v.id }}" title="{{ v.title }}" allowfullscreen></iframe>
        <div class="vc-body"><h4>{{ v.title }}</h4></div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="cta-band">
  <div class="container">
    {% if isAposentadoria %}
    <h2>Análise do seu CNIS para a concessão da melhor aposentadoria.</h2>
    <p>Fale com a nossa equipe pelo WhatsApp. Conferimos o CNIS e mostramos o que está errado ou faltando antes do pedido.</p>
    {% else %}
    <h2>A sua aposentadoria pode estar menor?</h2>
    <p>Fale com a nossa equipe pelo WhatsApp. Conferimos a carta de concessão e o CNIS e dizemos se a revisão vale a pena.</p>
    {% endif %}
    <a class="btn btn-gold" href="{{ waMsg | waLink }}" target="_blank" rel="noopener">{% waIcon %}Falar no WhatsApp</a>
    <p class="cta-links"><a href="{{ '/#analise' if isAposentadoria else '/revisao/aposentadoria' }}">{{ "Ver a análise do CNIS" if isAposentadoria else "Ver a área de revisão de aposentadoria" }}</a></p>
  </div>
</section>
</main>

{% include "layouts/footer.njk" %}
<script src="/assets/site.js?v=20261125b" defer></script>
</body>
</html>
