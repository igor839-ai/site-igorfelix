<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} | Igor Felix Advogados</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta name="robots" content="index, follow">
<meta property="og:type" content="article">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/{{ ogimage or 'og-image.jpg' }}">
<meta property="og:locale" content="pt_BR">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/blog.css">
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"Article",
  "headline":{{ title | dump | safe }},
  "description":{{ description | dump | safe }},
  "image":"{{ site.url }}/{{ ogimage or 'og-image.jpg' }}",
  "datePublished":"{{ date | isoDate }}",
  "dateModified":"{{ date | isoDate }}",
  "author":{"@type":"Person","name":"Igor Felix","jobTitle":"Advogado","identifier":"OAB/SP 321.638"},
  "publisher":{"@type":"LegalService","name":"Igor Felix Advogados Associados","url":"{{ site.url }}/"},
  "mainEntityOfPage":{"@type":"WebPage","@id":"{{ site.url }}{{ page.url }}"},
  "inLanguage":"pt-BR",
  "articleSection":{{ categories[category] | dump | safe }}
}
</script>
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name":"Início","item":"{{ site.url }}/"},
    {"@type":"ListItem","position":2,"name":"Blog","item":"{{ site.url }}/blog/"},
    {"@type":"ListItem","position":3,"name":{{ title | dump | safe }},"item":"{{ site.url }}{{ page.url }}"}
  ]
}
</script>
</head>
<body>

<header id="header" class="solid">
  <div class="container nav">
    <a href="/" class="brand" aria-label="Igor Felix Advogados Associados">
      <img src="/assets/logo.png" alt="Igor Felix Advogados Associados">
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Abrir menu"><span></span><span></span><span></span></button>
    <nav class="nav-menu" id="navMenu">
      <a href="/#areas">Áreas de atuação</a>
      <a href="/#como-funciona">Como funciona</a>
      <a href="/#avaliacoes">Avaliações</a>
      <a href="/#onde">Onde estamos</a>
      <a href="/blog/" class="active">Blog</a>
      <a class="nav-cta" href="{{ site.wa }}?text=Ol%C3%A1%21%20Li%20um%20artigo%20no%20blog%20e%20gostaria%20de%20tirar%20uma%20d%C3%BAvida." target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5s.8 1.9.8 2c.1.1.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .7-.2 1.2z"/></svg>
        WhatsApp
      </a>
    </nav>
  </div>
</header>

<article class="article-wrap">
  <div class="container">
    <nav class="breadcrumb" aria-label="Trilha">
      <a href="/">Início</a> ›
      <a href="/blog/">Blog</a> ›
      <span>{{ categories[category] }}</span>
    </nav>

    <div class="article-head">
      <span class="cat">{{ categories[category] }}</span>
      <h1>{{ title }}</h1>
      {% if sub %}<p class="sub">{{ sub }}</p>{% endif %}
      <div class="article-meta">
        <span>Por Dr. Igor Felix, OAB/SP 321.638</span>
        <span class="dot"></span>
        <span>{{ date | dateBR }}</span>
        <span class="dot"></span>
        <span>{{ content | readingTime }} min de leitura</span>
      </div>
    </div>

    <div class="prose">
      {{ content | safe }}
    </div>

    <div class="author">
      <div class="av">IF</div>
      <div>
        <h4>Dr. Igor Felix</h4>
        <p>Advogado previdenciário, OAB/SP 321.638. Atua com aposentadorias, revisões e benefícios do INSS.</p>
      </div>
    </div>
  </div>
</article>

{% set related = collections.posts | selectattr("data.category","equalto",category) | rejectattr("url","equalto",page.url) %}
{% if related.length %}
<section class="related">
  <div class="container">
    <span class="eyebrow">Continue lendo</span>
    <h2>Artigos sobre esse assunto</h2>
    <p class="lead">Outros conteúdos sobre {{ categories[category] | lower }}.</p>
    <div class="cards">
      {% for post in related | reverse | slice(0,3) %}
      <a class="card" href="{{ post.url }}">
        <div class="card-thumb"><span class="cat">{{ categories[post.data.category] }}</span></div>
        <div class="card-body">
          <h3 style="margin-top:.2rem">{{ post.data.title }}</h3>
          <p>{{ post.data.description }}</p>
          <span class="read">Ler artigo</span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="related" style="padding-top:0">
  <div class="container">
    <h2>Vídeos sobre esse assunto</h2>
    <p class="lead">Espaço para os vídeos do canal relacionados ao tema.</p>
    <div class="rel-videos">
      {% if videos %}
        {% for v in videos %}
        <div class="video-card">
          <iframe class="video-embed" loading="lazy" src="https://www.youtube-nocookie.com/embed/{{ v.id }}" title="{{ v.title }}" allowfullscreen></iframe>
          <div class="vc-body"><h4>{{ v.title }}</h4></div>
        </div>
        {% endfor %}
      {% else %}
        <div class="video-card">
          <div class="video-placeholder"><div class="play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div>
          <div class="vc-body"><h4>Em breve, vídeos sobre o tema</h4><p>Os vídeos do canal aparecem aqui.</p></div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<section class="cta-band">
  <div class="container">
    <h2>Tem uma dúvida sobre o seu benefício?</h2>
    <p>Fale com a nossa equipe pelo WhatsApp. O primeiro atendimento é para entender o seu caso e orientar os próximos passos.</p>
    <a class="btn btn-gold" href="{{ site.wa }}?text=Ol%C3%A1%21%20Li%20um%20artigo%20no%20blog%20e%20gostaria%20de%20tirar%20uma%20d%C3%BAvida." target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5s.8 1.9.8 2c.1.1.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .7-.2 1.2z"/></svg>
      Falar no WhatsApp
    </a>
  </div>
</section>

<footer>
  <div class="container">
    <div class="footer-grid">
      <div>
        <img src="/assets/logo.png" alt="Igor Felix Advogados Associados" style="width:210px;height:auto;margin-bottom:1.2rem">
        <p style="max-width:340px;font-size:.86rem;color:rgba(247,245,240,.6)">Advocacia previdenciária especializada em aposentadorias, revisões e benefícios do INSS. Atendimento digital em todo o Brasil.</p>
      </div>
      <div>
        <h4>Contato</h4>
        <ul class="footer-contact">
          <li><svg viewBox="0 0 24 24" stroke-width="1.8" stroke="#E4C784"><path d="M21 11.5a8.5 8.5 0 0 1-11.9 7.8L3 21l1.7-6.1A8.5 8.5 0 1 1 21 11.5z" stroke-linecap="round" stroke-linejoin="round"/></svg>(11) 97169-4420 (WhatsApp)</li>
          <li><svg viewBox="0 0 24 24" stroke-width="1.8" stroke="#E4C784"><path d="M12 21s-7-5.1-7-11a7 7 0 0 1 14 0c0 5.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>R. Pais Leme, 136, Sala 502 (Neo Offices Faria Lima)<br>Pinheiros, São Paulo-SP, CEP 05424-010</li>
          <li><svg viewBox="0 0 24 24" stroke-width="1.8" stroke="#E4C784"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z"/></svg>Atendimento digital em todo o Brasil</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Igor Felix Advogados Associados. OAB/SP 321.638. Todos os direitos reservados.</span>
      <span>Conteúdo meramente informativo, em conformidade com o Código de Ética da OAB. Cada caso é único e resultados passados não garantem resultados futuros.</span>
    </div>
  </div>
</footer>

<script>
const header=document.getElementById('header');
addEventListener('scroll',()=>header.classList.toggle('scrolled',scrollY>40));
const t=document.getElementById('navToggle'),m=document.getElementById('navMenu');
t.addEventListener('click',()=>m.classList.toggle('open'));
m.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>m.classList.remove('open')));
</script>
</body>
</html>
