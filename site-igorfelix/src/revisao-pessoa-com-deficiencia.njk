<script>
window.QUIZ = {
  questions: [
    { q: 'Você já é aposentado ou está prestes a se aposentar?', opts: ['Sim, já sou aposentado', 'Ainda não, mas vou pedir em breve', 'Não'] },
    { q: 'Você é pessoa com deficiência (física, sensorial, intelectual ou mental)?', opts: ['Sim', 'Acho que sim, não tenho certeza', 'Não'] },
    { q: 'Você já tinha essa deficiência durante o seu tempo de contribuição?', opts: ['Sim', 'Não sei dizer', 'Não'] },
    { q: 'O INSS avaliou a sua deficiência e aplicou a LC 142?', opts: ['Não aplicou', 'Não sei dizer', 'Sim, aplicou'] },
    { q: 'Há quanto tempo você se aposentou?', opts: ['Menos de 10 anos', 'Mais de 10 anos', 'Ainda não me aposentei'] }
  ],
  result: function (a) {
    if (a[1] === 'Não') return { title: 'Essa revisão depende de deficiência reconhecida', text: 'Existem outras revisões possíveis, como tempo especial, ação trabalhista e erro de cálculo. Envie as respostas e conte a sua situação.', link: { href: '/revisao/aposentadoria', label: 'Ver as outras revisões' } };
    if (a[4] === 'Mais de 10 anos') return { title: 'Vale conferir o prazo', text: 'Com mais de 10 anos de aposentadoria, o prazo de revisão pode ter terminado. A contagem começa no mês seguinte ao primeiro pagamento. Envie as respostas e a carta de concessão para conferirmos.' };
    if (a[4] === 'Ainda não me aposentei') return { title: 'Peça a aposentadoria já pela LC 142', text: 'Como você ainda não se aposentou, a deficiência pode ser considerada já no pedido. Envie as respostas, o CNIS e os laudos que tiver.', link: { href: '/analise-do-cnis/pessoa-com-deficiencia', label: 'Ver as regras da aposentadoria da pessoa com deficiência' } };
    return { title: 'O seu caso merece uma análise', text: 'Pelas respostas, vale verificar se a LC 142 pode melhorar o seu benefício. Envie as respostas e a carta de concessão. A nossa equipe analisa e explica o próximo passo.' };
  },
  summary: function (a) {
    return 'Olá! Vim pelo site e fiz o teste da revisão da aposentadoria da pessoa com deficiência (LC 142). Minhas respostas: 1) Benefício do INSS: ' + a[0] + '; 2) É pessoa com deficiência: ' + a[1] + '; 3) Deficiência durante a contribuição: ' + a[2] + '; 4) INSS aplicou a LC 142: ' + a[3] + '; 5) Tempo desde a aposentadoria: ' + a[4] + '. Gostaria de uma análise do meu caso.';
  }
};
</script>

